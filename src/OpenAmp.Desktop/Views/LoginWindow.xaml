<Window x:Class="OpenAmp.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenAmp prijava" Width="470" Height="610"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="110" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="#111115" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="42" Height="42" CornerRadius="10" Background="{StaticResource AccentBrush}" Margin="0,0,12,0">
                    <TextBlock Text="O" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock FontSize="28" FontWeight="Bold" VerticalAlignment="Center">
                    <Run Text="Open" /><Run Text="Amp" Foreground="{StaticResource AccentBrush}" />
                </TextBlock>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="54,48,54,40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="Prijava za studio" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,28" />
            <StackPanel Grid.Row="1" Margin="0,0,0,18">
                <TextBlock Text="Username ili email" Style="{StaticResource MutedText}" Margin="0,0,0,7" />
                <TextBox Text="{Binding Identifier, UpdateSourceTrigger=PropertyChanged}" Height="42" />
            </StackPanel>
            <StackPanel Grid.Row="2" Margin="0,0,0,22">
                <TextBlock Text="Lozinka" Style="{StaticResource MutedText}" Margin="0,0,0,7" />
                <PasswordBox x:Name="PasswordInput" Height="42" KeyDown="PasswordInput_KeyDown" />
            </StackPanel>
            <Button Grid.Row="3" Content="Prijavi se" Style="{StaticResource AccentButton}"
                    Height="44" Click="Login_Click" />
            <TextBlock Grid.Row="4" Text="{Binding Error}" Foreground="{StaticResource DangerBrush}"
                       TextWrapping="Wrap" Margin="0,14,0,0" />
            <Border Grid.Row="5" VerticalAlignment="Bottom" Background="#17171C" CornerRadius="8" Padding="13">
                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                           Text="Lokalni razvojni račun: admin / OpenAmp1!" />
            </Border>
        </Grid>
    </Grid>
</Window>
