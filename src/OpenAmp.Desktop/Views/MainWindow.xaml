<Window x:Class="OpenAmp.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenAmp Studio" Width="1480" Height="920"
        MinWidth="1180" MinHeight="740" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="214" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="88" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="82" />
                </Grid.RowDefinitions>
                <Image Width="142" Height="44" Stretch="Uniform"
                       HorizontalAlignment="Left" VerticalAlignment="Center"
                       Margin="20,0,0,0">
                    <Image.Source>
                        <CroppedBitmap Source="/OpenAmp.Desktop;component/Assets/openamp-wordmark.png"
                                       SourceRect="126,420,788,180" />
                    </Image.Source>
                </Image>

                <StackPanel Grid.Row="1" Margin="0,18,0,0">
                    <TextBlock Text="STUDIO" Style="{StaticResource EyebrowText}" Margin="26,0,0,10" />
                    <Button Command="{Binding NavigateCommand}" CommandParameter="0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedPage}" Value="0">
                                        <Setter Property="Tag" Value="True" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <TextBlock Text="01" FontFamily="Bahnschrift" Foreground="{StaticResource AccentBrush}" FontSize="11" />
                            <TextBlock Grid.Column="1" Text="Pregled" />
                        </Grid>
                    </Button>
                    <Button Command="{Binding NavigateCommand}" CommandParameter="1">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedPage}" Value="1">
                                        <Setter Property="Tag" Value="True" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <TextBlock Text="02" FontFamily="Bahnschrift" Foreground="{StaticResource AccentBrush}" FontSize="11" />
                            <TextBlock Grid.Column="1" Text="Sale" />
                        </Grid>
                    </Button>
                    <Button Command="{Binding NavigateCommand}" CommandParameter="2">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedPage}" Value="2">
                                        <Setter Property="Tag" Value="True" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <TextBlock Text="03" FontFamily="Bahnschrift" Foreground="{StaticResource AccentBrush}" FontSize="11" />
                            <TextBlock Grid.Column="1" Text="Oprema" />
                        </Grid>
                    </Button>
                    <Button Command="{Binding NavigateCommand}" CommandParameter="3">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedPage}" Value="3">
                                        <Setter Property="Tag" Value="True" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <TextBlock Text="04" FontFamily="Bahnschrift" Foreground="{StaticResource AccentBrush}" FontSize="11" />
                            <TextBlock Grid.Column="1" Text="Rezervacije" />
                        </Grid>
                    </Button>
                    <Button Command="{Binding NavigateCommand}" CommandParameter="4">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedPage}" Value="4">
                                        <Setter Property="Tag" Value="True" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <TextBlock Text="05" FontFamily="Bahnschrift" Foreground="{StaticResource AccentBrush}" FontSize="11" />
                            <TextBlock Grid.Column="1" Text="Bendovi" />
                        </Grid>
                    </Button>
                    <Button Command="{Binding NavigateCommand}" CommandParameter="5">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedPage}" Value="5">
                                        <Setter Property="Tag" Value="True" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <TextBlock Text="06" FontFamily="Bahnschrift" Foreground="{StaticResource AccentBrush}" FontSize="11" />
                            <TextBlock Grid.Column="1" Text="Artikli" />
                        </Grid>
                    </Button>
                    <Button Command="{Binding NavigateCommand}" CommandParameter="6">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedPage}" Value="6">
                                        <Setter Property="Tag" Value="True" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <TextBlock Text="07" FontFamily="Bahnschrift" Foreground="{StaticResource AccentBrush}" FontSize="11" />
                            <TextBlock Grid.Column="1" Text="Korisnici" />
                        </Grid>
                    </Button>
                </StackPanel>

                <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" CornerRadius="4" Background="{StaticResource AccentSoftBrush}">
                            <TextBlock Text="{Binding Initials}" FontFamily="Bahnschrift" FontSize="11"
                                       Foreground="{StaticResource AccentBrush}" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentUser}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding CurrentRole}" Style="{StaticResource MutedText}" FontSize="11" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="86" />
                <RowDefinition Height="*" />
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>
            <Border Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="30,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="OPENAMP / STUDIO" Style="{StaticResource EyebrowText}" Margin="0,0,0,5" />
                        <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitle}" />
                    </StackPanel>
                    <Button Command="{Binding RefreshCommand}" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Style="{StaticResource QuietButton}" Padding="10,7">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↻" FontSize="17" Margin="0,-2,7,0" />
                            <TextBlock Text="Osvježi" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedPage}" Margin="30,24">
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,18">
                                <Grid MinHeight="116">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5" />
                                        <ColumnDefinition Width="1.35*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{StaticResource AccentBrush}" CornerRadius="5,0,0,5" />
                                    <StackPanel Grid.Column="1" Margin="24,0" VerticalAlignment="Center">
                                        <TextBlock Text="DANAS" Style="{StaticResource EyebrowText}" Foreground="{StaticResource AccentBrush}" />
                                        <TextBlock Text="{Binding TodayLabel}" FontFamily="Bahnschrift" FontSize="20"
                                                   FontWeight="SemiBold" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                                        <StackPanel Margin="22,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Dashboard.DanasnjeProbe}" Style="{StaticResource MetricNumber}" />
                                            <TextBlock Text="termina" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                                        <StackPanel Margin="22,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Dashboard.AktivneSale}" Style="{StaticResource MetricNumber}" />
                                            <TextBlock Text="aktivne sale" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                                        <Grid Margin="22,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Dashboard.OpremaNaNajmu}" Style="{StaticResource MetricNumber}" />
                                                <TextBlock Text="na najmu" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Dashboard.NiskeZalihe}" Style="{StaticResource MetricNumber}"
                                                           Foreground="{StaticResource DangerBrush}" />
                                                <TextBlock Text="niske zalihe" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.55*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Card}" Margin="0,0,9,0">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="Raspored" Style="{StaticResource SectionTitle}" />
                                            <TextBlock Text="DANAS" Style="{StaticResource EyebrowText}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Top" />
                                        </Grid>
                                        <Border Padding="0,20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Dashboard.RasporedDanas.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="Danas nema rezervacija." Style="{StaticResource MutedText}" />
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding Dashboard.RasporedDanas}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,0" MinHeight="68">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="68" />
                                                            <ColumnDefinition Width="18" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Vrijeme}" FontFamily="Bahnschrift" FontSize="13"
                                                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        <Grid Grid.Column="1">
                                                            <Border Width="1" Background="{StaticResource BorderBrush}"
                                                                    HorizontalAlignment="Center" />
                                                            <Border Width="7" Height="7" CornerRadius="4"
                                                                    Background="{StaticResource AccentBrush}"
                                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Grid>
                                                        <StackPanel Grid.Column="2" Margin="13,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Bend}" FontSize="14" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding Sala}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,3,0,0" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="3" Text="{Binding Status}" Style="{StaticResource MutedText}"
                                                                   FontSize="11" VerticalAlignment="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="9,0,0,0">
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="Zauzetost sala" Style="{StaticResource SectionTitle}" />
                                                <TextBlock Text="7 DANA" Style="{StaticResource EyebrowText}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Top" />
                                            </Grid>
                                            <ScrollViewer MaxHeight="244" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding Dashboard.ZauzetostSedmica}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,6,14">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="54" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Sala}" FontWeight="SemiBold" FontSize="12"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding Datum, StringFormat=dd.MM.}" Style="{StaticResource MutedText}"
                                                                               FontSize="10" Margin="0,2,0,7" />
                                                                    <ProgressBar Value="{Binding Postotak}" Maximum="100" />
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="1" Text="{Binding Postotak, StringFormat={}{0}%}"
                                                                           FontFamily="Bahnschrift" FontSize="14"
                                                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="Zalihe" Style="{StaticResource SectionTitle}" />
                                                <TextBlock Text="ISPOD MINIMUMA" Style="{StaticResource EyebrowText}"
                                                           Foreground="{StaticResource DangerBrush}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Top" />
                                            </Grid>
                                            <TextBlock Text="Sve zalihe su uredne." Margin="0,4,0,8">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Dashboard.UpozorenjaZaliha.Count}" Value="0">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <ItemsControl ItemsSource="{Binding Dashboard.UpozorenjaZaliha}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="3" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Background="{StaticResource DangerBrush}" CornerRadius="2" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Naziv}" Margin="10,0" FontWeight="SemiBold" />
                                                            <TextBlock Grid.Column="2" Text="{Binding StanjeZalihe}" Style="{StaticResource MutedText}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem>
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding HallSearch, UpdateSourceTrigger=PropertyChanged}" Height="40" Margin="0,0,10,0"
                                     ToolTip="Naziv sale ili studija" />
                            <Button Grid.Column="1" Content="Pretraži" Command="{Binding ApplyFiltersCommand}" Margin="0,0,10,0" />
                            <Button Grid.Column="2" Content="Nova sala" Command="{Binding AddHallCommand}" Style="{StaticResource AccentButton}" />
                        </Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Halls}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Width="355" Margin="0,0,16,16" Padding="0">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="150" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="5,5,0,0">
                                                    <Grid>
                                                        <Image Width="128" Height="40" Opacity="0.13" Stretch="Uniform">
                                                            <Image.Source>
                                                                <CroppedBitmap Source="/OpenAmp.Desktop;component/Assets/openamp-wordmark.png"
                                                                               SourceRect="126,420,788,180" />
                                                            </Image.Source>
                                                        </Image>
                                                        <Image Source="{Binding SlikaUrl}" Stretch="UniformToFill" />
                                                        <Border Width="38" Height="3" Background="{StaticResource AccentBrush}"
                                                                HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Row="1" Margin="17">
                                                    <Grid>
                                                        <TextBlock Text="{Binding Naziv}" FontSize="18" FontWeight="Bold" />
                                                        <Border HorizontalAlignment="Right" CornerRadius="3" Padding="8,3"
                                                                 Background="{Binding StatusKod, Converter={StaticResource StatusBrushConverter}}">
                                                            <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold" Foreground="White" />
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Studio}" Style="{StaticResource MutedText}" Margin="0,4,0,10" />
                                                    <TextBlock>
                                                        <Run Text="{Binding Kapacitet}" /><Run Text=" osoba   ·   " />
                                                        <Run Text="{Binding CijenaPoSatu}" /><Run Text=" KM/h" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding OpremaTekst}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" Margin="0,9,0,14" />
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="Uredi" Command="{Binding DataContext.EditHallCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" Padding="11,6" Margin="0,0,7,0" />
                                                        <Button Content="Slika" Command="{Binding DataContext.UploadHallImageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                 CommandParameter="{Binding}" Padding="11,6" Margin="0,0,7,0" />
                                                        <Button Content="Deaktiviraj" Command="{Binding DataContext.DeactivateHallCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" Padding="11,6" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>

                <TabItem>
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,18">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding EquipmentSearch, UpdateSourceTrigger=PropertyChanged}" Height="40" Margin="0,0,10,0" />
                            <Button Grid.Column="1" Content="Pretraži" Command="{Binding ApplyFiltersCommand}" Margin="0,0,10,0" />
                            <Button Grid.Column="2" Content="Nova oprema" Command="{Binding AddEquipmentCommand}" Style="{StaticResource AccentButton}" />
                        </Grid>
                        <DataGrid ItemsSource="{Binding Equipment}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="INV. BROJ" Binding="{Binding InventarskiBroj}" Width="120" />
                                <DataGridTextColumn Header="NAZIV" Binding="{Binding Naziv}" Width="*" />
                                <DataGridTextColumn Header="KATEGORIJA" Binding="{Binding Kategorija}" Width="140" />
                                <DataGridTextColumn Header="SALA" Binding="{Binding Sala}" Width="130" />
                                <DataGridTextColumn Header="CIJENA/H" Binding="{Binding CijenaNajmaPoSatu, StringFormat={}{0:0.00} KM}" Width="105" />
                                <DataGridTextColumn Header="STANJE" Binding="{Binding StanjeTekst}" Width="105" />
                                <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="120" />
                                <DataGridTemplateColumn Header="" Width="270">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Uredi" Padding="10,5" Margin="0,0,6,0"
                                                        Command="{Binding DataContext.EditEquipmentCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                <Button Content="Kvar" Padding="10,5" Margin="0,0,6,0"
                                                        Command="{Binding DataContext.ReportServiceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                <Button Content="Završi servis" Padding="10,5"
                                                        Command="{Binding DataContext.CompleteServiceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <TabItem>
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="‹" Command="{Binding PreviousWeekCommand}" Padding="13,7" />
                                <TextBlock Text="{Binding WeekLabel}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="15,0" />
                                <Button Content="›" Command="{Binding NextWeekCommand}" Padding="13,7" />
                            </StackPanel>
                            <Button Grid.Column="3" Content="Nova rezervacija" Command="{Binding AddReservationCommand}" Style="{StaticResource AccentButton}" />
                        </Grid>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding WeekDays}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Width="174" MinHeight="560" Margin="0,0,10,0" Padding="12">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Dan}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                                <TextBlock Text="{Binding DatumTekst}" FontSize="19" FontWeight="SemiBold" Margin="0,2,0,14" />
                                                <ItemsControl ItemsSource="{Binding Rezervacije}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Command="{Binding DataContext.EditReservationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}" Padding="0" Margin="0,0,0,8" HorizontalContentAlignment="Stretch">
                                                                <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="4"
                                                                        BorderBrush="#4A2821" BorderThickness="1" Padding="10">
                                                                    <Grid>
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="3" />
                                                                            <RowDefinition Height="*" />
                                                                        </Grid.RowDefinitions>
                                                                        <Border Background="{StaticResource AccentBrush}" CornerRadius="2" />
                                                                        <StackPanel Grid.Row="1" Margin="0,9,0,0">
                                                                            <TextBlock Text="{Binding Vrijeme}" FontFamily="Bahnschrift"
                                                                                       FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                                                                            <TextBlock Text="{Binding Bend}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                                                            <TextBlock Text="{Binding Sala}" Style="{StaticResource MutedText}"
                                                                                       FontSize="11" TextTrimming="CharacterEllipsis" />
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>

                <TabItem>
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,18">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding BandSearch, UpdateSourceTrigger=PropertyChanged}" Height="40" Margin="0,0,10,0" />
                            <Button Grid.Column="1" Content="Pretraži" Command="{Binding ApplyFiltersCommand}" />
                        </Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Bands}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                            <StackPanel>
                                                <Grid>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Naziv}" FontSize="20" FontWeight="Bold" Margin="0,0,10,0" />
                                                            <TextBlock Text="{Binding Zanr}" Style="{StaticResource EyebrowText}"
                                                                       Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Statistika}" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                                                    </StackPanel>
                                                    <Button Content="Uredi" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="12,6"
                                                            Command="{Binding DataContext.EditBandCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding Clanovi}" Margin="0,18,0,0">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{StaticResource ControlBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                                                                    Padding="11,10" Margin="0,0,12,4" MinWidth="190">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding ImePrezime}" FontWeight="SemiBold" />
                                                                    <TextBlock Text="{Binding Username, StringFormat=@{0}}" Foreground="{StaticResource AccentBrush}" FontSize="11" />
                                                                    <TextBlock Text="{Binding Instrument}" Style="{StaticResource MutedText}" FontSize="11" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>

                <TabItem>
                    <DockPanel>
                        <Button DockPanel.Dock="Top" Content="Novi artikal" Command="{Binding AddArticleCommand}"
                                Style="{StaticResource AccentButton}" HorizontalAlignment="Right" Margin="0,0,0,18" />
                        <DataGrid ItemsSource="{Binding Articles}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="INV. BROJ" Binding="{Binding InventarskiBroj}" Width="130" />
                                <DataGridTextColumn Header="NAZIV" Binding="{Binding Naziv}" Width="*" />
                                <DataGridTextColumn Header="KATEGORIJA" Binding="{Binding Kategorija}" Width="130" />
                                <DataGridTextColumn Header="STUDIO" Binding="{Binding Studio}" Width="150" />
                                <DataGridTextColumn Header="ZALIHA" Binding="{Binding StanjeZalihe}" Width="130" />
                                <DataGridTextColumn Header="CIJENA" Binding="{Binding Cijena, StringFormat={}{0:0.00} KM}" Width="100" />
                                <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="110" />
                                <DataGridTemplateColumn Header="" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Uredi" Padding="10,5" Command="{Binding DataContext.EditArticleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <TabItem>
                    <DataGrid ItemsSource="{Binding Users}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="KORISNIK" Binding="{Binding ImePrezime}" Width="*" />
                            <DataGridTextColumn Header="USERNAME" Binding="{Binding Username}" Width="150" />
                            <DataGridTextColumn Header="EMAIL" Binding="{Binding Email}" Width="220" />
                            <DataGridTextColumn Header="ULOGA" Binding="{Binding Uloga}" Width="150" />
                            <DataGridCheckBoxColumn Header="AKTIVAN" Binding="{Binding Aktivan}" Width="85" />
                            <DataGridTextColumn Header="KREIRAN" Binding="{Binding KreiranUtc, StringFormat=dd.MM.yyyy}" Width="110" />
                            <DataGridTemplateColumn Header="" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Uredi" Padding="10,5" Command="{Binding DataContext.EditUserCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>

            <Border Grid.Row="2" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" FontSize="10" VerticalAlignment="Center" Margin="12,0" />
            </Border>
        </Grid>
    </Grid>
</Window>
