<Application x:Class="OpenAmp.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:OpenAmp.Desktop.Infrastructure"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <infra:StatusBrushConverter x:Key="StatusBrushConverter" />
            <infra:GenreBrushConverter x:Key="GenreBrushConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
